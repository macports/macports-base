# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

package require tcltest 2
namespace import tcltest::*

set pwd [file dirname [file normalize $argv0]]

set macports_dir $pwd/../../macports1.0
source ${macports_dir}/macports_test_autoconf.tcl
source ${macports_dir}/tests/test_setup.tcl

package require portlib

test get_archive_sites_conf_values {
    Get archive sites conf values unit test.
} -setup {
    file mkdir $pwd/archive_sites
    set fd [open $pwd/archive_sites/archive_sites.conf w+]
    puts $fd "name fondu"
    puts $fd "urls macports.org"
    puts $fd "type tgz"
    close $fd

    set macports::archive_sites_conf $pwd/archive_sites/archive_sites.conf
} -body {
    set res [portlib::archive_sites::get_archive_sites_conf_values]
    puts $res
    if {![dict exists $res sites fondu]} {
        return "FAIL: name not set"
    }
    if {[dict get $res sites fondu] ne "macports.org:nosubdir"} {
        return "FAIL: wrong sites set"
    }
    if {![dict exists $res archive_type fondu]} {
        return "FAIL: type not set"
    }
    if {[dict get $res archive_type fondu] ne "tgz"} {
        return "FAIL: wrong type set"
    }

    return "Get archive sites conf values successful."

} -cleanup {
    file delete -force $pwd/archive_sites
} -result "Get archive sites conf values successful."


test supportedArchiveTypes {
    Supported archive types unit test.
    Only tests xar, zip, cpio.
} -body {
    set archives [portlib::util::supportedArchiveTypes]

    foreach archive $archives {
        if {$archive == "xar" && ![file exists ${::portlib::autoconf::xar_path}]} {
            return "FAIL: xar detected but inexistent"
        }
        if {$archive == "zip" && ![file exists ${::portlib::autoconf::zip_path}]} {
            return "FAIL: zip detected but inexistent"
        }
        if {$archive == "cpio" && ![file exists ${::portlib::autoconf::pax_path}]} {
            return "FAIL: cpio detected but inexistent"
        }
    }
    return "Supported archives successful."
} -result "Supported archives successful."


test get_archive_site_lazy_load {
    Ensure get_archive_site_* lazily initializes conf_sites and global sites.
} -setup {
    set saved_conf $macports::archive_sites_conf
    set saved_sites $portlib::archive_sites::sites
    if {[info exists portlib::archive_sites::conf_sites]} {
        set saved_conf_sites $portlib::archive_sites::conf_sites
        unset portlib::archive_sites::conf_sites
    }
    set portlib::archive_sites::sites [dict create]

    file mkdir $pwd/archive_sites_lazy
    set conf_path $pwd/archive_sites_lazy/archive_sites.conf
    set fd [open $conf_path w]
    puts $fd "name localconf"
    puts $fd "urls https://conf.example.org"
    puts $fd "type tbz2"
    puts $fd "prefix $macports::prefix"
    puts $fd "applications_dir $macports::applications_dir"
    puts $fd "frameworks_dir $macports::frameworks_dir_frozen"
    puts $fd "cxx_stdlib $macports::cxx_stdlib"
    puts $fd "delete_la_files $macports::delete_la_files"
    close $fd
    set macports::archive_sites_conf $conf_path

    set mirror_path $pwd/archive_sites_lazy/archive_sites.tcl
    set fd [open $mirror_path w]
    puts $fd "namespace eval portfetch::mirror_sites {}"
    puts $fd "set portfetch::mirror_sites::sites(globaltest) {https://global.example.org/:nosubdir}"
    puts $fd "set portfetch::mirror_sites::archive_type(globaltest) tbz2"
    puts $fd "set portfetch::mirror_sites::archive_prefix(globaltest) [list $macports::prefix]"
    puts $fd "set portfetch::mirror_sites::archive_applications_dir(globaltest) [list $macports::applications_dir]"
    puts $fd "set portfetch::mirror_sites::archive_frameworks_dir(globaltest) [list $macports::frameworks_dir_frozen]"
    puts $fd "set portfetch::mirror_sites::archive_cxx_stdlib(globaltest) [list $macports::cxx_stdlib]"
    puts $fd "set portfetch::mirror_sites::archive_delete_la_files(globaltest) [list $macports::delete_la_files]"
    puts $fd "set portfetch::mirror_sites::archive_sigtype(globaltest) signify"
    puts $fd "set portfetch::mirror_sites::archive_pubkey(globaltest) /tmp/test.pub"
    close $fd
} -body {
    list \
        [portlib::archive_sites::get_archive_site_urls $mirror_path localconf] \
        [portlib::archive_sites::get_archive_site_archivetype $mirror_path localconf] \
        [portlib::archive_sites::get_archive_site_urls $mirror_path globaltest] \
        [portlib::archive_sites::get_archive_site_sigtype $mirror_path globaltest] \
        [portlib::archive_sites::get_archive_site_pubkey $mirror_path globaltest]
} -cleanup {
    set macports::archive_sites_conf $saved_conf
    set portlib::archive_sites::sites $saved_sites
    if {[info exists saved_conf_sites]} {
        set portlib::archive_sites::conf_sites $saved_conf_sites
    } elseif {[info exists portlib::archive_sites::conf_sites]} {
        unset portlib::archive_sites::conf_sites
    }
    file delete -force $pwd/archive_sites_lazy
} -result {https://conf.example.org:nosubdir tbz2 https://global.example.org/:nosubdir signify /tmp/test.pub}


cleanupTests
