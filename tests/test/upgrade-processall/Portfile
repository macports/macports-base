# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem      1.0

name            upgrade-processall
version         1
categories      test
maintainers     nomaintainer
description     Test ports for upgrades with -p
homepage        https://www.macports.org/
platforms       darwin
supported_archs noarch
configure.cxx_stdlib

long_description ${description}

subport upgrade-processall-broken {}
subport upgrade-processall-ok {}
subport upgrade-processall-conflict {}

# The tests create flag files in the test prefix. The PortIndex keeps
# version 1 (portindex does not expand ${prefix}), but port upgrade
# reads the version from this Portfile, so the flag makes the port
# outdated.
if {[file exists ${prefix}/var/test/${subport}.version2]} {
    version     2
}

distfiles
use_configure   no
# No binary archives: a binary-only rebuild fails.
archive_sites

build {
    if {[file exists ${prefix}/var/test/${subport}.fail]} {
        error "build failure requested by the test"
    }
}
# Each build writes a different value, to tell a rebuild from the
# installed version.
destroot {
    xinstall -d ${destroot}${prefix}/var/test
    set fd [open ${destroot}${prefix}/var/test/${subport} w]
    puts $fd [clock microseconds]
    close $fd
    # A file of the upgrade-processall port, so that activation fails.
    if {[file exists ${prefix}/var/test/${subport}.conflict]} {
        close [open ${destroot}${prefix}/var/test/upgrade-processall w]
    }
}
